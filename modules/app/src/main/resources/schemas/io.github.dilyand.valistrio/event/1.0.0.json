{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "data"],
  "definitions": {
    "schemaRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*/[a-z][a-z0-9_]*/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  },
  "properties": {
    "schema": { "const": "io.github.dilyand.valistrio/event/1.0.0" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meta", "body"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["event_id", "produced_at"],
          "properties": {
            "event_id":    { "type": "string", "format": "uuid" },
            "produced_at": { "type": "string" }
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "data"],
          "properties": {
            "schema": { "$ref": "#/definitions/schemaRef" },
            "data":   { "type": "object" }
          }
        },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "data"],
            "properties": {
              "schema": { "$ref": "#/definitions/schemaRef" },
              "data":   { "type": "object" }
            }
          }
        }
      }
    }
  }
}
