{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "data"],
  "properties": {
    "schema": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meta", "event"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["event_id", "produced_at"],
          "properties": {
            "event_id":    { "type": "string", "format": "uuid" },
            "produced_at": { "type": "string", "format": "date-time" }
          }
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "data"],
          "properties": {
            "schema": { "type": "string" },
            "data":   { "type": "object" }
          }
        },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "data"],
            "properties": {
              "schema": { "type": "string" },
              "data":   { "type": "object" }
            }
          }
        }
      }
    }
  }
}
